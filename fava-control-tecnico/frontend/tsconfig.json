{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "useDefineForClassFields": true,
    // El alias que shadcn da por hecho: sus componentes se copian con imports
    // `@/components/ui/...` y `@/lib/utils`. Sin esto, cada `add` habria que
    // reescribirlo a mano y dejaria de ser copiar-pegar.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
