{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc --noEmit -p tsconfig.json && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "demo:datos": "tsx scripts/demo-datos.ts",
    "smoke": "tsx scripts/smoke.ts",
    "notificar": "tsx scripts/notificar.ts",
    "migrate:excel": "tsx prisma/migrate-excel.ts",
    "migrate:ordenes": "tsx prisma/migrate-ordenes.ts",
    "migrate:notas": "tsx prisma/migrate-notas.ts",
    "informe": "tsx scripts/informe-excel.ts",
    "cuentas": "tsx scripts/crear-cuentas.ts",
    "usuarios:tecnicos": "tsx scripts/crear-usuarios-tecnicos.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "^17.2.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.4",
    "nestjs-pino": "^4.6.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "7.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.11",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!jose/)"
    ],
    "testEnvironment": "node"
  }
}
