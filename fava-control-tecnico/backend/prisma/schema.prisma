// Prisma 7. El motor Rust desaparecio: el cliente habla por el adapter PrismaPg
// (src/common/prisma/prisma.service.ts) y la URL de migraciones vive en prisma.config.ts.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Sin cjs NestJS no arranca: el bundle ESM no se puede require() desde dist/.
  moduleFormat = "cjs"
}

// Prisma 7 rechaza `url` aqui: la de migraciones va en prisma.config.ts y la del
// cliente la trae el adapter. Asi el runtime no puede acabar conectado como owner.
datasource db {
  provider = "postgresql"
}

/// Coincide con `type Role = 'T' | 'A' | 'S'` del frontend (frontend/src/types.ts).
enum Role {
  T
  A
  S

  @@map("role")
}

/// CAT-01. Los 8 codigos son FIJOS (decision bloqueada del CONTEXT). Enum de
/// Postgres = el catalogo no puede crecer ni por un bug de servicio ni por SQL
/// suelto. Las etiquetas visibles (mutables) viven en la tabla `concepts`.
/// OJO con LR/NR: la hoja Parametros del Excel llama «LR» a los codigos 4 y 5;
/// el 4 es NR (no remunerado, solo EXTERNOS) y el 5 es LR (solo internos).
enum ConceptCode {
  DC
  MD
  DFD
  DVSF
  DVRC
  LR
  NR
  IL

  @@map("concept_code")
}

/// Montaje / collaudo. En el Excel la fase solo existe en el lado *vendido*
/// (hojas de proyecto); las hojas diarias no la traen. De ahi que en
/// `daily_entries` sea nullable y en `order_sold_days` obligatoria.
enum Phase {
  MONTAJE
  COLLAUDO

  @@map("phase")
}

/// Interno = plantilla FAVA, externo = contratista. No es decorativo: la hoja
/// Parametros reserva NR a los externos y LR a los internos.
enum EmploymentType {
  INTERNO
  EXTERNO

  @@map("employment_type")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Identidad definitiva tras el primer login. El email solo sirve para la
  /// vinculacion inicial y despues es dato de visualizacion.
  /// @unique = lookup por peticion sin seq scan (el guard no cachea, AUTH-04).
  entraOid    String? @unique @map("entra_oid")
  email       String  @unique
  displayName String  @map("display_name")

  roles    Role[]
  isActive Boolean @default(true) @map("is_active")

  /// Idioma de SUS correos: 'es' | 'it' | 'pt'. Los tres que ya habla la interfaz.
  /// No es un enum de Postgres como `role` porque un idioma nuevo es una traduccion
  /// mas, no una decision de negocio bloqueada; el dominio cerrado lo pone un CHECK
  /// en la migracion, que se cambia sin tocar el tipo.
  lang String @default("es")

  /// Un usuario <-> un tecnico. De aqui sale la GUC `app.technician_id` que aisla
  /// la bitacora, asi que dos usuarios apuntando al mismo tecnico serian dos
  /// identidades con la misma bitacora: @unique lo impide en el motor.
  technicianId String? @unique @map("technician_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@map("users")
}

/// Solicitud del boton «solicitar acceso» de la pantalla sin-acceso.
/// Los Admins la ven en la pantalla de Usuarios (el feed de notificaciones es Fase 7).
model AccessRequest {
  id          String @id @default(uuid()) @db.Uuid
  entraOid    String @unique @map("entra_oid")
  email       String
  displayName String @map("display_name")

  /// pending | dismissed
  status String @default("pending")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("access_requests")
}

/// Forma definitiva minima. Se crea en Fase 1 para que el spike de RLS
/// (Plan 01-02) corra sobre las tablas reales y Fase 3 las encuentre hechas.
/// Los campos source_* son los de la migracion del Excel (Fase 6): definirlos
/// ahora evita migrar dos veces.
model DailyEntry {
  id           String   @id @default(uuid()) @db.Uuid
  technicianId String   @map("technician_id") @db.Uuid
  date         DateTime @db.Date

  /// draft | submitted | approved | returned
  status String @default("draft")

  /// Nullable por BIT-03: el Excel usa «Sin Proyecto» como centinela en 1.438 filas
  /// y un centinela en la tabla seria peor que un NULL honesto.
  projectId String? @map("project_id") @db.Uuid

  /// EL campo que hoy falta y que justifica el proyecto entero: a que maquina
  /// contratada fue esta jornada. De las 536 filas de JAV en el Excel, CERO lo dicen,
  /// y por eso Andrea reparte 151 dias de Camilo Cruz en 120 + 31 a mano.
  ///
  /// Nullable por el historico (Fase 6) y por las jornadas sin proyecto. El servicio
  /// lo exige cuando hay proyecto; la agregacion mantiene un bucket «sin orden» en vez
  /// de descartar, que seria mentir por omision.
  orderId String? @map("order_id") @db.Uuid

  /// Apunta al modelo GLOBAL, no a la seleccion del proyecto: asi quitar una
  /// maquina de un proyecto nunca rompe ni vacia el historico. Se queda ademas de
  /// `order_id` porque el historico trae la maquina como texto y sin orden.
  machineModelId String? @map("machine_model_id") @db.Uuid

  /// «En Fabrica» es un MODIFICADOR de DC y DFD, no un concepto aparte: la hoja
  /// `Parametros` se lo pega a la etiqueta, pero los datos usan las dos variantes bajo
  /// el mismo numero (1.109 con y 1.133 sin). Como concepto separado duplicaria el
  /// catalogo cerrado de 8.
  inFactory Boolean @default(false) @map("in_factory")

  /// El «sin texto libre» de CAT-01, a nivel de tipo. Sin relacion a `concepts`
  /// a proposito: el enum ya constrine la columna y una FK obligaria a leer el
  /// catalogo en cada escritura de bitacora sin ganar ninguna garantia.
  conceptCode ConceptCode? @map("concept_code")

  /// Nullable a proposito: las hojas diarias del Excel no tienen columna de fase y
  /// TODO el historico entra con NULL. La agregacion necesita un bucket «sin fase»
  /// o el tablero miente por omision.
  phase Phase?

  /// BIT-01: el texto del trabajo del dia. Lo imprime el cuerpo de la Nota Semanal
  /// (Fase 5) en cada una de las 7 filas. Nullable porque el historico del Excel
  /// (Fase 6) trae filas sin descripcion y un '' obligatorio seria peor que un NULL.
  description String?

  /// Snapshot del rol con el que trabajo ESE dia, no el del maestro. 5 de los 14
  /// tecnicos del Excel tienen mas de un `Tipo` (Ivan Cortes: Software 652 filas +
  /// Capo Elettricista 78). Sin esta columna la Fase 6 pierde informacion.
  roleTypeId String? @map("role_type_id") @db.Uuid

  sourceYear  Int?    @map("source_year")
  sourceSheet String? @map("source_sheet")
  sourceRow   Int?    @map("source_row")

  /// El texto CRUDO de la columna «Maquina» del Excel, tal cual. No es
  /// `machine_model_id` ni `order_id` porque no es ninguna de las dos cosas: son
  /// valores como `PL 6000 PC 4500` (dos maquinas sin separador),
  /// `CTA1000,PC4500` o `Pasta Corta 340300 / Pasta Larga 340200 / Nidos 340400`
  /// (tres, con la commessa embebida). Convertirlo a una orden seria inventarse
  /// cual; tirarlo seria perder la unica pista que existe para atribuirlas despues.
  sourceMachine String? @map("source_machine")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // onDelete: Restrict explicito en las cuatro. Prisma pone SetNull por defecto en
  // las relaciones opcionales: borrar un proyecto por error vaciaria en silencio el
  // project_id de la bitacora. Nada de Cascade en ningun sitio de este esquema.
  technician   Technician    @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  machineModel MachineModel? @relation(fields: [machineModelId], references: [id], onDelete: Restrict)
  roleType     RoleType?     @relation(fields: [roleTypeId], references: [id], onDelete: Restrict)

  /// BIT-02: un tecnico registra un dia una sola vez.
  /// El indice de esta unique ya sirve para filtrar por technician_id.
  @@unique([technicianId, date])
  @@map("daily_entries")
}

/// NOTA-01. El tecnico NUNCA crea ni elige notas: al enviar la semana, el servidor
/// deriva UNA POR PROYECTO agrupando sus jornadas. Si trabajo en dos proyectos, salen
/// dos notas y el las ve ya hechas.
model WeeklyNote {
  id           String   @id @default(uuid()) @db.Uuid
  technicianId String   @map("technician_id") @db.Uuid
  /// Lunes de la semana ISO. DATE, nunca timestamptz (misma regla que daily_entries).
  weekStart    DateTime @map("week_start") @db.Date

  /// NOT NULL: una nota la firma el CLIENTE de un proyecto. Las jornadas sin proyecto
  /// (libres, no remunerados) no pertenecen a ninguna nota — nadie las firma.
  projectId String @map("project_id") @db.Uuid

  /// draft | submitted | approved | returned
  status String @default("draft")

  /// NOTA-09: el cargo puede variar por SEMANA. Nace con el del maestro del tecnico y
  /// es editable, porque el mismo Ivan es electricista una semana y softwerista otra
  /// —lo pidio Andrea explicitamente— y la Nota impresa lleva el de ESA semana.
  roleTypeId String? @map("role_type_id") @db.Uuid

  /// NOTA-03: obligatorio al devolver, y por eso vive aqui y no solo en el audit_log:
  /// es lo que el tecnico LEE para saber que corregir.
  returnComment String? @map("return_comment")

  /// NOTA-07. Sube con cada `reopen`. El PDF de la version anterior NO se borra: es la
  /// evidencia de lo que el cliente firmo aquel dia, y regenerarlo seria justo el
  /// pitfall que la investigacion marca como el mas caro de esta fase.
  version Int @default(1)

  /// NOTA-07. SHA-256 de lo que el cliente vio al firmar: los 7 dias, los gastos y el
  /// encabezado. Si al reabrir y reenviar el contenido cambia, la firma se invalida; si
  /// solo se corrigio una falta de ortografia en un comentario interno, sigue valiendo.
  /// Distinguirlo es la diferencia entre pedirle al cliente que vuelva a firmar o no.
  signedContentHash String? @map("signed_content_hash")

  /// NOTA-08. Hasta 4 lineas cada uno, como las tablas fijas del PDF (`bloqueGastos` en
  /// nota-pdf.ts): `[{descripcion, valor}]`. JSON y no una tabla propia porque son
  /// informativos, sin flujo de reembolso ni aprobacion — una tabla con su propia RLS
  /// seria ceremonia para cuatro lineas de texto que nadie consulta sueltas. Editables
  /// solo hasta firmar (`signedContentHash` nulo); despues quedan congelados en el PDF.
  gastosTecnico    Json? @map("gastos_tecnico")
  anticiposCliente Json? @map("anticipos_cliente")

  sourceYear  Int?    @map("source_year")
  sourceSheet String? @map("source_sheet")
  sourceRow   Int?    @map("source_row")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  technician Technician      @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  roleType   RoleType?       @relation(fields: [roleTypeId], references: [id], onDelete: Restrict)
  pdfs       NotePdf[]
  signatures NoteSignature[]
  receipts   ExpenseReceipt[]

  /// La clave natural de la derivacion: reenviar la misma semana NO duplica notas.
  @@unique([technicianId, weekStart, projectId])
  @@index([status])
  @@map("weekly_notes")
}

/// NOTA-06 — el PDF CONGELADO.
///
/// Los bytes viven en la columna y no en un bucket externo, a proposito. Un PDF de esta
/// nota pesa ~150 KB y salen ~1.560 al ano: 230 MB anuales, que Postgres lleva sin
/// despeinarse y que entran en la copia de seguridad de la base sin configurar nada.
/// Un bucket S3 anadiria credenciales, un servicio mas que puede caer y un modo de
/// fallo nuevo (la fila existe, el objeto no) a cambio de nada a esta escala.
///
/// La fila es INMUTABLE: la migracion no le da politica de UPDATE ni de DELETE, igual
/// que al audit_log. Descargar el PDF de hace un ano devuelve los MISMOS bytes y el
/// mismo hash porque no se vuelve a renderizar nunca — es el pitfall central de la
/// fase segun la investigacion.
model NotePdf {
  id     String @id @default(uuid()) @db.Uuid
  noteId String @map("note_id") @db.Uuid

  /// La version de la nota a la que corresponde. Reabrir crea otra fila, no pisa esta.
  version Int

  bytes  Bytes
  /// SHA-256 de `bytes`, en hexadecimal. Lo comprueba quien descarga.
  sha256 String

  createdAt DateTime @default(now()) @map("created_at")

  note WeeklyNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@unique([noteId, version])
  @@map("note_pdfs")
}

/// NOTA-04 — la firma y su expediente de evidencia.
///
/// «Firma digital» aqui significa un trazo en un canvas guardado como PNG: es una firma
/// ELECTRONICA, no criptografica. Si FAVA pidiera algun dia no repudio legal (PAdES,
/// certificado X.509) eso es otro problema y otra libreria; nada de lo pedido lo exige.
/// Lo que si se guarda es todo lo que hace defendible la electronica: quien firmo, con
/// que documento, en que cargo, que acepto la declaracion, cuando SEGUN EL SERVIDOR
/// (nunca segun el reloj del movil), desde donde y sobre que bytes exactos.
/// NOTA-08b — el comprobante de un gasto: la foto del ticket.
///
/// CUELGA DE LA NOTA Y NO DE UNA LINEA de `gastos_tecnico`. Atarlo al indice del array
/// seria fragil: se borra una linea, los indices bailan y el recibo queda apuntando a
/// otro gasto. Como se aprueban JUNTOS —el mismo boton que aprueba la semana— saber
/// que ticket respalda que renglon exacto no cambia ninguna decision; `label` basta.
///
/// LOS BYTES VIVEN EN LA COLUMNA, igual que `note_pdfs` y `note_signatures`. No hay
/// bucket externo en este proyecto y meterlo por esto seria una dependencia y unas
/// credenciales nuevas. La cuenta que SI hay que respetar: una foto de movil son 3-8 MB
/// y el volumen tiene 5 GB, asi que el cliente la redimensiona antes de subir y el
/// servidor rechaza lo que pase de `RECIBO_MAX_BYTES`. Con ~300 KB por ticket, trece
/// tecnicos y tres tickets por semana son ~600 MB al ano.
model ExpenseReceipt {
  id     String @id @default(uuid()) @db.Uuid
  noteId String @map("note_id") @db.Uuid

  /// Que es: «botas», «peaje», «hotel». Lo escribe el tecnico al subirlo.
  label String

  /// 'image/jpeg' | 'image/png' | 'application/pdf'. Lista cerrada en el servicio.
  mimeType  String @map("mime_type")
  bytes     Bytes
  /// Tamano ya guardado. Se guarda para poder listar sin traerse los bytes.
  sizeBytes Int    @map("size_bytes")

  /// Quien lo subio. Sin FK, mismo criterio que `audit_log.actor_id`.
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  // Restrict como el resto del esquema: un recibo es evidencia, y borrar la nota que
  // lo respalda tiene que costar tanto como borrar su PDF o su firma.
  note WeeklyNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@index([noteId])
  @@map("expense_receipts")
}

model NoteSignature {
  id     String @id @default(uuid()) @db.Uuid
  noteId String @map("note_id") @db.Uuid

  /// La version firmada. Con `version` en la clave, reabrir no borra la firma vieja.
  version Int

  /// 'technician' | 'client'
  kind String

  signerName     String  @map("signer_name")
  signerDocument String? @map("signer_document")
  signerRole     String? @map("signer_role")

  /// La aceptacion EXPLICITA de la declaracion de conformidad. Sin esto, el trazo es
  /// un dibujo: lo que da valor a la firma es que alguien acepto un texto concreto.
  declarationAccepted Boolean @map("declaration_accepted")

  /// El trazo del canvas, PNG. Se estampa en el PDF y se conserva aparte.
  imagePng Bytes @map("image_png")

  /// SHA-256 del PDF que se firmo. Si no coincide con el de `note_pdfs`, alguien mintio.
  pdfSha256 String @map("pdf_sha256")

  /// Reloj del SERVIDOR. El del dispositivo del cliente no vale como evidencia.
  signedAt  DateTime @default(now()) @map("signed_at")
  ip        String?
  userAgent String?  @map("user_agent")

  note WeeklyNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@unique([noteId, version, kind])
  @@map("note_signatures")
}

/// AUD-01. Append-only POR MOTOR, no por convencion: la migracion le da politica de
/// SELECT e INSERT y NINGUNA de UPDATE ni DELETE, asi que el default-deny de Postgres
/// bloquea reescribir la historia incluso desde SQL suelto y siendo admin.
///
/// No tiene FK a `users`: un Restrict impediria dar de baja al usuario que hizo la
/// transicion y un SetNull/Cascade falsearia el rastro. Mismo criterio que
/// `projects.created_by_id`.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Quien. Se guarda ademas el nombre porque el rastro tiene que seguir siendo legible
  /// aunque el usuario se borre o se renombre.
  actorId   String @map("actor_id") @db.Uuid
  actorName String @map("actor_name")

  /// CAT-06: aprobar en nombre de un tecnico dado de baja. NULL en el caso normal.
  onBehalfOfId String? @map("on_behalf_of_id") @db.Uuid

  /// Que se toco: 'weekly_note' | 'daily_entry' | 'project' | ...
  entity   String
  entityId String @map("entity_id") @db.Uuid

  /// La transicion: 'submit' | 'approve' | 'return' | 'reopen' | 'update' | ...
  action String

  /// El antes y el despues, como JSON. Solo los campos que cambiaron: guardar la fila
  /// entera haria el log ilegible y multiplicaria su tamano por nada.
  before Json?
  after  Json?

  /// Obligatorio en `return` y `reopen` (lo exige el servicio, no el motor: el motor no
  /// sabe que acciones lo necesitan).
  reason String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// El buzon de salida de los avisos por correo.
///
/// Quien dispara el aviso NO envia: escribe una fila. El envio lo hace el cron
/// (`scripts/notificar.ts`) en otro proceso. Es obligado, no una preferencia de
/// estilo: `RlsInterceptor` abre UNA transaccion por peticion y prohibe I/O externo
/// dentro (pool de 10, timeout de 10 s); un POST a Graph dentro de `transicionar()`
/// agota el pool y acaba en P2028.
///
/// Y de paso resuelve lo que un envio directo no puede: «no me llego el aviso» deja
/// de ser indepurable. Mismo criterio que `audit_log`.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  /// La idempotencia, y esta en el MOTOR: se inserta con `createMany({ skipDuplicates })`
  /// -> ON CONFLICT DO NOTHING. Un cron que corra dos veces en la misma ventana no manda
  /// dos correos, y no hay que acordarse de comprobarlo en ningun sitio.
  /// Formato: '<kind>:<id>:<discriminante>'. Ver `plantillas.ts`.
  dedupeKey String @unique @map("dedupe_key")

  /// 'note_returned' | 'note_approved' | 'week_missing' | 'admin_digest'
  kind String

  /// El destinatario congelado. Se guarda el correo y no solo el id porque el aviso
  /// tiene que seguir siendo legible aunque el usuario cambie de direccion o se borre
  /// — mismo motivo por el que `audit_log` guarda `actor_name`.
  toEmail String  @map("to_email")
  /// Sin FK a `users`, igual que `audit_log.actor_id`: un Restrict impediria dar de
  /// baja a quien recibio un aviso.
  toUserId String? @map("to_user_id") @db.Uuid

  /// El idioma con el que se RENDERIZO, que puede no ser el que el usuario tenga hoy.
  lang String

  /// Renderizado al encolar, no al enviar. Asi la fila es autosuficiente: el envio no
  /// hace joins, y queda escrito que se mando EXACTAMENTE.
  subject  String
  bodyText String @map("body_text")

  /// pending | sending | sent | failed
  status   String  @default("pending")
  attempts Int     @default(0)
  /// Cuando lo reclamo el drenador. Un proceso que muere a mitad deja la fila en
  /// 'sending' para siempre; con esto se puede recuperar pasado un rato.
  claimedAt DateTime? @map("claimed_at")
  lastError String?   @map("last_error")

  /// De que se hablaba, para poder rastrear. 'weekly_note' + el id de la nota.
  entity   String?
  entityId String? @map("entity_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  /// El indice del drenador: `WHERE status = 'pending' ORDER BY created_at`.
  @@index([status, createdAt])
  @@index([entity, entityId])
  @@map("notifications")
}

// ─────────────────────────── Fase 2: maestros y catalogos ───────────────────────────

/// CAT-01. Ocho filas, sembradas por la MIGRACION y no por seed.ts: son estructura.
/// Si un deploy olvida `db:seed`, un catalogo vacio rompe la captura de la Fase 3 y
/// la pantalla Config. Aqui vive solo lo MUTABLE (las etiquetas y el orden); el
/// codigo es el enum, y por eso esta tabla no puede crecer ni encoger.
model Concept {
  code      ConceptCode @id
  labelEs   String      @map("label_es")
  labelIt   String      @map("label_it")
  sortOrder Int         @map("sort_order")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("concepts")
}

/// ABM completo del Super Admin. El Excel tenia ~21 grafias de rol para 14 tecnicos:
/// cablear tres roles en el codigo es demostrablemente falso. Consecuencia de diseno:
/// las FILAS de la matriz vendido/ejecutado se generan desde este catalogo.
model RoleType {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  technicians  Technician[]
  soldDays     OrderSoldDays[]
  dailyEntries DailyEntry[]
  weeklyNotes  WeeklyNote[]

  @@map("role_types")
}

/// ABM simple: codigo y simbolo. Sin tasas de cambio (fuera de alcance).
model Currency {
  /// ISO-4217: 3 letras mayusculas. @unique normal, no parcial: desactivar una
  /// moneda NO libera su codigo, y la UI ofrece reactivarla.
  code     String  @id
  symbol   String
  isActive Boolean @default(true) @map("is_active")

  orders Order[]

  @@map("currencies")
}

/// Catalogo GLOBAL de los modelos que FAVA fabrica; la seleccion por proyecto vive
/// en `project_machines`. La descripcion libre no es decorativa: es lo que permite
/// que la linea «Maquinaria:» de la Nota diga «Linea Pasta Larga 4500 Kg/h» y no
/// «PL6000». Sustituye al texto libre con separadores mixtos del Excel
/// («CTA1000,PC4500», «CTA1000/PL6000», «PL 6000 PC 4500»).
model MachineModel {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  orders       Order[]
  dailyEntries DailyEntry[]

  @@map("machine_models")
}

/// CAT-02. Desacoplada de `users` a proposito: los tecnicos historicos del Excel no
/// tienen cuenta Entra y hay que poder registrarles jornadas igual. El vinculo
/// opcional con una cuenta es `users.technician_id`.
model Technician {
  id             String         @id @default(uuid()) @db.Uuid
  fullName       String         @map("full_name")
  roleTypeId     String         @map("role_type_id") @db.Uuid
  employmentType EmploymentType @map("employment_type")

  /// El correo de la PERSONA, no el de su cuenta. Un tecnico existe antes de tener
  /// acceso a la aplicacion, y hasta ahora el correo vivia solo en `users`: uno sin
  /// cuenta no era contactable por ningun medio. Es ademas la clave con la que ficha y
  /// cuenta se unen solas (ver `users.service.ts`), en vez de a mano desde un desplegable.
  /// El indice unico va sobre `lower(email)` y se declara en la migracion: Prisma no
  /// sabe expresar un indice sobre una funcion.
  email String?

  /// Las grafias con las que el tecnico aparece en el Excel («Leomar/Leomir»,
  /// «Klein/Kleir»). Las consume la conciliacion de la Fase 6 (MIG-01).
  aliases String[] @default([])

  /// Desactivar, nunca borrar: deja de ofrecerse en formularios nuevos y sus
  /// jornadas historicas siguen siendo legibles.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleType     RoleType     @relation(fields: [roleTypeId], references: [id], onDelete: Restrict)
  user         User?
  dailyEntries DailyEntry[]
  weeklyNotes  WeeklyNote[]

  @@index([isActive])
  @@map("technicians")
}

/// CAT-03. Los campos del bloque «encabezado» son exactamente los que imprime la
/// Nota Semanal (Fase 5), extraidos del PDF de ejemplo por coordenadas.
model Project {
  id String @id @default(uuid()) @db.Uuid

  /// Nombre interno (listas y KPIs). El que sale impreso es `clientName`.
  name String

  // ── Encabezado literal de la Nota Semanal ──

  /// «Cliente:». Sin tabla `clients` en v1: KPI-04 agrupa por este texto y el
  /// autocompletado con <datalist> mitiga las grafias duplicadas.
  clientName String @map("client_name")

  /// CAT-03. OJO Fase 5: NO es el «NIT:» que imprime la Nota — ese es el de FAVA
  /// (901137532-4), constante del membrete. Esta columna NUNCA va en esa casilla del PDF.
  clientNit String? @map("client_nit")

  /// «Localidad:» SIN pais. Son dos columnas porque KPI-04 pide «dias por cliente y
  /// pais» y una cadena unica lo impide; la Nota las imprime unidas por «, ».
  locality String
  country  String

  /// «Suministro:»
  supply String

  /// «Contrato:», y tambien el valor de la columna NOTA de los 7 dias (no es un
  /// campo aparte). Texto, no numero: es un identificador («345500», «OA0163864»).
  contractNumber String @map("contract_number")

  // ── Comercial ──
  //
  // `oa_number`, `contract_value` y `currency_code` ESTUVIERON aqui y se fueron a
  // `orders` en la Fase 2.1: J Macedo tiene dos lineas de maquina y CERO OA a nivel
  // de proyecto, y JAV tiene tres importes distintos. El valor del proyecto es la
  // suma de sus ordenes y por eso no se persiste.

  /// El «nh» del prototipo: horas normales pactadas por jornada.
  normalHours Int? @map("normal_hours")

  isActive Boolean @default(true) @map("is_active")

  /// Rastro de autoria, sin FK a proposito: un Restrict impediria dar de baja al
  /// usuario que lo creo y un SetNull/Cascade falsearia el rastro.
  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders       Order[]
  dailyEntries DailyEntry[]
  weeklyNotes  WeeklyNote[]

  @@index([isActive])
  @@map("projects")
}

/// La MAQUINA CONTRATADA, y la dueña del contrato. Sustituye a `project_machines`,
/// que era un enlace sin datos y no distinguia dos maquinas iguales del mismo proyecto.
///
/// JAV Marata tiene tres: dos `PL 6000 KG` que solo se diferencian por la commessa
/// (342898 y 342998) y una `PC 4000 + 4 SILOS`, cada una con su OA y su importe
/// (182.500 / 182.500 / 130.000). A nivel de proyecto no hay ni OA ni valor, asi que
/// esos campos NO pueden vivir en `projects`.
model Order {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// Lo que el tecnico ve al elegir: «PL 6000 KG - 1-3428». Es la etiqueta literal
  /// de la hoja de proyecto, no una composicion nuestra: incluye alcance que el
  /// modelo no tiene («+ 4 SILOS»).
  label String

  /// Nullable: hay ordenes cuyo alcance no es un modelo del catalogo.
  machineModelId String? @map("machine_model_id") @db.Uuid

  /// La commessa larga tal cual («342898»). @unique: identifica la maquina en toda
  /// la casa matriz y es la clave con la que Andrea ubica el trabajo en la cotizacion.
  commessa String? @unique

  /// Los 4 primeros digitos («3428»), que es como se nombra en obra y en las notas
  /// de los tecnicos. Columna propia y no un substring: el histrico trae la corta
  /// suelta, sin la larga.
  commessaShort String? @map("commessa_short")

  /// Correlativo cruzando maquinas Y clientes (JAV: 0159105/0159107/0159108;
  /// Lucchetti: 0159103). Por eso es de la orden y nunca del proyecto.
  oaNumber String? @map("oa_number")

  /// El importe RESERVADO, que es lo que guarda la hoja — no la suma de las lineas
  /// de la cotizacion: Lucchetti suma 168.500 y reserva 160.000.
  contractValue Decimal? @map("contract_value") @db.Decimal(14, 2)
  currencyCode  String?  @map("currency_code")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  machineModel MachineModel?   @relation(fields: [machineModelId], references: [id], onDelete: Restrict)
  currency     Currency?       @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  soldDays     OrderSoldDays[]
  dailyEntries DailyEntry[]

  @@index([projectId])
  @@map("orders")
}

/// CAT-04. Una LINEA de la cotizacion. Cuelga de la ORDEN, no del proyecto: lo vendido
/// se cotiza y se controla por maquina.
///
/// NO existe columna `delta`: es `sold_days - ejecutado` y lo calcula el servidor en
/// cada lectura. Tampoco hay CHECK que impida quedar por debajo de lo ejecutado — el
/// delta negativo es un hecho real del negocio (Resoconto fila 39: 20 | 332 | -312).
model OrderSoldDays {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  roleTypeId String @map("role_type_id") @db.Uuid
  phase      Phase

  /// Una cotizacion real trae DOS lineas `MECCATRONICO` (265 y 98) en el mismo bloque,
  /// asi que (orden, rol, fase) NO es unico. La pantalla edita siempre el ordinal 0;
  /// los demas los crea la migracion de la Fase 6.
  ordinal Int @default(0)

  /// Algunas lineas no son un rol del catalogo sino un nombre propio
  /// («FELIPE SENA» a 85 EUR/dia, «FELIPE SENA (COSTO)»). Se guarda el literal para
  /// no falsear el rol; si es NULL, manda el nombre del rol.
  lineLabel String? @map("line_label")

  /// `TOT GG CON VIAGGI` de la cotizacion — NO `GIORNI EFFETTIVI`. En JAV son 182 y
  /// 141: incluye viajes y domingos, y el importe tambien se calcula sobre esta.
  /// Confundirlas descuadra el delta un ~30%.
  /// >= 0, validado en el servicio (Postgres no modela CHECK desde Prisma).
  soldDays Int @map("sold_days")

  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  roleType RoleType @relation(fields: [roleTypeId], references: [id], onDelete: Restrict)

  /// Clave natural del upsert por celda (autoguardado al salir del campo).
  @@unique([orderId, roleTypeId, phase, ordinal])
  @@map("order_sold_days")
}
