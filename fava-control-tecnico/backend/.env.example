# FAVA Control Técnico — backend
# Copiar a .env y rellenar. El .env real está gitignored: nunca se commitea.
# Documentación completa de cada variable: docs/ENV.md
# De dónde salen los valores de Entra: docs/ENTRA-SETUP.md

# ── Base de datos ─────────────────────────────────────────────────────────────
# DOS conexiones a propósito. El runtime NUNCA usa la del owner: el usuario
# `postgres` es dueño de las tablas y salta RLS sin dejar ningún síntoma.
# No añadir ?connection_limit=: en Prisma 7 se ignora en silencio (el pool se
# configura en el adapter PrismaPg, ver src/common/prisma/prisma.service.ts).

# Runtime — rol fava_app (NOBYPASSRLS, no dueño). SECRETA.
DATABASE_URL="postgresql://fava_app:CAMBIAME@localhost:5432/fava?schema=public"

# Owner — sólo bootstrap, migraciones y seed. SECRETA.
# En local, credenciales del servicio `db` de docker-compose.yml.
# En Railway: ${{Postgres.DATABASE_URL}}
MIGRATE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fava?schema=public"

# Password que db-bootstrap asigna al rol fava_app. SECRETA.
# Debe coincidir con la que aparece en DATABASE_URL.
APP_DB_PASSWORD="CAMBIAME"

# ── Microsoft Entra ID ────────────────────────────────────────────────────────
# Entra → Overview → Directory (tenant) ID
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Registro A (FAVA Control Tecnico API) → Application (client) ID
# Es el `aud` que valida el guard. OJO: el del API, no el del SPA.
ENTRA_API_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Nombre del scope expuesto por el registro A. Sólo cambia si se renombra.
ENTRA_REQUIRED_SCOPE="access_as_user"

# ── Aplicación ────────────────────────────────────────────────────────────────
# Email de la cuenta que el seed crea como Super Admin (roles T+A+S).
SEED_SUPERADMIN_EMAIL="tu.cuenta@tu-tenant.onmicrosoft.com"

# Railway lo inyecta automáticamente; en local no hace falta tocarlo.
PORT=3000

# ── Login de desarrollo temporal (Plan 01-07) ─────────────────────────────────
# APAGADO. Existe solo mientras FAVA no tenga tenant de Entra; al llegar el
# tenant real hay que quitar estas dos variables Y limpiar los OID ficticios
# (UPDATE users SET entra_oid = NULL WHERE entra_oid LIKE 'dev:%'). El porqué,
# en docs/ENV.md § Login de desarrollo temporal.
# Solo acepta 'true' o 'false': cualquier otro valor no arranca.
#DEV_AUTH_ENABLED="false"

# Contraseña compartida. Obligatoria y de 12 caracteres o más si el flag está
# encendido: sin ella el proceso muere al arrancar. SECRETA, y generada al azar.
#DEV_AUTH_PASSWORD=""

# ── Avisos por correo (Fase 9) ────────────────────────────────────────────────
# `console` imprime los avisos y los marca enviados sin tocar la red. Es el
# dry-run, el modo de los tests y con el que se despliega la fase entera antes
# de que Entra conceda Mail.Send. Sólo acepta 'console' o 'graph'.
NOTIF_TRANSPORT="console"

# Zona en la que se leen «viernes» y «las 16:00». Una sola para todo el sistema.
# Nombre IANA: Intl sabe de horario de verano y un desfase fijo no.
NOTIF_TZ="America/Bogota"

# Las cuatro siguientes SÓLO hacen falta con NOTIF_TRANSPORT="graph". Con `graph`
# son obligatorias y el proceso no arranca sin ellas.

# Buzón remitente. Necesita Mail.Send (permiso de APLICACIÓN) sobre el registro
# dedicado al correo, y una Application Access Policy de Exchange que acote el
# envío a este único buzón — si no, se puede enviar desde cualquier buzón del
# tenant, incluido el del director.
#NOTIF_FROM="techportal@favalatinoamerica.com"

# Application (client) ID del registro DEDICADO al correo (FAVA Avisos). NO es
# ENTRA_API_CLIENT_ID: son dos aplicaciones distintas a propósito.
#ENTRA_MAIL_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Secreto de ESE registro → Certificates & secrets → New client secret. SECRETA.
#ENTRA_CLIENT_SECRET=""

# Raíz pública de la app, para el enlace que lleva a la nota desde el correo.
#APP_BASE_URL="https://techportalfava.lat"
